+def test_a_store_on_a_new_object_starts_no_chain(tree, monkeypatch):
+    # with no deleting destructor to start from, that store is no constructor of the table
+    _registered_other(tree)
+    other = {TABLE: SHARED[TABLE], OTHER_TABLE: ([GADGET_COUNT, 0x00401000], {OTHER_STORE: 0})}
+    retail(monkeypatch, other)
+    retail_code(monkeypatch, {OTHER_START: _new_then_store(), WIDGET_CTOR: WIDGET_STORES})
+    refused(tree)
+
+
+# A deleting destructor is read by what it does.
+
+DELETE_AT = 0x0040A000
+
+
+def _delete_body(at, destructor, delete=None):
+    # push esi; mov esi,ecx; call ~X; test byte ptr [esp+8],1; je +7; push esi; call delete; pop ecx; mov eax,esi; pop esi; ret 4
+    head = b"\x56\x8b\xf1" + _call(at + 3, destructor) + b"\xf6\x44\x24\x08\x01\x74\x07\x56"
+    return head + _call(at + len(head), delete or DELETE_AT) + b"\x59\x8b\xc6\x5e\xc2\x04\x00"
+
+
+def _deleting_tree(tree):
+    functions = tree / "reverse/functions.csv"
+    functions.write_text(functions.read_text() + "??_GOther@@UAEPAXI@Z,,0x00403060,32,Code/Game/Other.cpp,matched,d\n"
+                         "?method@Other@@QAEPAXI@Z,,0x00403080,32,Code/Game/Other.cpp,matched,m\n"
+                         f"??3@YAXPAX@Z,,0x{DELETE_AT:08X},8,Code/Game/Other.cpp,matched,delete\n"
+                         "?free@Other@@QAEXXZ,,0x0040A010,8,Code/Game/Other.cpp,matched,not delete\n")
+
+
+def _deleting_tables(slot):
+    # no installer of Other's table at all: only the deleting slot can start a chain
+    return {TABLE: ([0x00403040, 0x00401000, 0x00404000], {CTOR_STORE: 0}), OTHER_TABLE: ([slot, 0x00401000], {})}
+
+
+def test_a_deleting_destructor_starts_a_chain_whatever_its_row_is_called(tree, monkeypatch):
+    _deleting_tree(tree)
+    retail(monkeypatch, _deleting_tables(0x00403080))
+    retail_code(monkeypatch, {WIDGET_CTOR: WIDGET_STORES, 0x00403040: _delete_body(0x00403040, WIDGET_CTOR),
+                              0x00403080: _delete_body(0x00403080, WIDGET_CTOR)})
+    assert "0x00403080>0x00402000" in str(vars(plan(tree)))
+
+
+def test_a_method_with_a_deleting_shape_that_frees_nothing_starts_no_chain(tree, monkeypatch):
