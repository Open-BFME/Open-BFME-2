+
+def _new_then_store():
+    # push 0x10; call new; cmp eax,ebx; pop ecx; je over; mov dword ptr [eax], table: retail's W3DShroud ctor at 0x73391
+    body = b"\x90" * 4 + b"\x6a\x10" + _call(OTHER_START + 6, NEW_AT) + b"\x3b\xc3\x59\x74\x06"
+    assert OTHER_START + len(body) == OTHER_STORE
+    return body + b"\xc7\x00" + OTHER_VPTR + b"\xc3"
