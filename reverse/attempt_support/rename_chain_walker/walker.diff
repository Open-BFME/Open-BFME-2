+def retail_code(monkeypatch, code):
+    """Retail's bytes: {rva: bytes} over int3s."""
+    import build
+
+    def read(rva, size):
+        out = bytearray(b"\xcc" * size)
+        for start, data in code.items():
+            for at, byte in enumerate(data):
+                if rva <= start + at < rva + size:
+                    out[start + at - rva] = byte
+        return bytes(out)
+    monkeypatch.setattr(build, "read_target_bytes", read)
