+def test_the_chain_proof_is_off_outside_the_to_class_plan(tree, monkeypatch):
+    # function --respell's this-cv route reads the same evidence function and keeps the view-only test
+    other_row(monkeypatch, _call(AFTER_STORE, WIDGET_CTOR) + b"\xc3")
+    with pytest.raises(Refusal, match="unrelated to Widget"):
+        rename.to_class_evidence(ctx_of(tree), 0x00401000, "Widget", {"Code/Game/Bits.cpp"})
+
+
+# A canonical header that says otherwise keeps its veto unless the store is proved to be on another object.
+
+NEW_AT = 0x00409000
+
+
+def _registered_other(tree):
+    (tree / "reverse/canonical_classes.csv").write_text("class,header,evidence\nOther,Code/Game/OtherClass.h,x\n")
+    (tree / "Code/Game/OtherClass.h").write_text("class Plain {};\nclass Other : public Plain {};\n")
+    functions = tree / "reverse/functions.csv"
+    functions.write_text(functions.read_text() + f"??2@YAPAXI@Z,,0x{NEW_AT:08X},8,Code/Game/Other.cpp,matched,new\n")
+
+
+def _chain_by_the_deleting_slot(monkeypatch, other_start):
+    # A real chain through Other's deleting destructor, so only the canonical veto can refuse: without the veto, each
+    # of these is accepted.
+    tables = dict(SHARED)
+    tables[OTHER_TABLE] = ([0x00403060, 0x00401000], {OTHER_STORE: 0})
+    retail(monkeypatch, tables)
+    retail_code(monkeypatch, {OTHER_START: other_start, WIDGET_CTOR: WIDGET_STORES,
+                              0x00403040: _delete_body(0x00403040, WIDGET_CTOR),
+                              0x00403060: _delete_body(0x00403060, WIDGET_CTOR)})
+
+
+def test_the_chain_by_the_deleting_slot_is_accepted_with_no_header(tree, monkeypatch):
+    # the control for the three vetoes below
+    _deleting_tree(tree)
+    _chain_by_the_deleting_slot(monkeypatch, OWN_STORE + b"\xc3")
+    assert "0x00403060>0x00402000" in str(vars(plan(tree)))
+
+
+def test_a_canonical_header_with_a_complete_other_chain_still_refuses(tree, monkeypatch):
+    _deleting_tree(tree)
+    _registered_other(tree)
+    _chain_by_the_deleting_slot(monkeypatch, OWN_STORE + b"\xc3")
+    refused(tree)
+
+
+def test_a_branch_before_the_install_keeps_the_canonical_veto(tree, monkeypatch):
+    # test ecx,ecx; jne +0 ahead of the genuine install: the receiver cannot be read, which is not another receiver
+    _deleting_tree(tree)
+    _registered_other(tree)
+    _chain_by_the_deleting_slot(monkeypatch, b"\x85\xc9\x75\x00" + b"\x90" * 12 + b"\xc7\x01" + OTHER_VPTR + b"\xc3")
+    refused(tree)
