+def test_a_table_stored_on_a_new_object_does_not_veto(tree, monkeypatch):
+    # retail's W3DShroud: the header says no base, but its ctor stores the table on the object it allocated
+    _deleting_tree(tree)
+    _registered_other(tree)
+    _chain_by_the_deleting_slot(monkeypatch, _new_then_store())
+    assert "0x00403060>0x00402000" in str(vars(plan(tree)))
