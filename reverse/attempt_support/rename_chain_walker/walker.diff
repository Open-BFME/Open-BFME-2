+def test_a_store_through_a_loaded_pointer_keeps_the_canonical_veto(tree, monkeypatch):
+    # mov eax,[ecx+4]; mov dword ptr [eax], table: some other object, but nothing proves a new one
+    _deleting_tree(tree)
+    _registered_other(tree)
+    _chain_by_the_deleting_slot(monkeypatch, b"\x8b\x41\x04" + b"\x90" * 13 + b"\xc7\x00" + OTHER_VPTR + b"\xc3")
+    refused(tree)
