+// Target-neutral atomic reference protocol; the original class name is unknown.
+// Native 0x50EC8/0x50ED3/0x50EFA pass the LONG at +4 to the Interlocked APIs.
+// Release_Ref invokes virtual destruction through slot 0, then scalar delete.
+// This declaration describes that eight-byte prefix, not an allocation size:
+// payload, subclasses and the original complete-object layout remain unknown.
+#ifndef BFME2_OPAQUE_REF_COUNTED_H
+#define BFME2_OPAQUE_REF_COUNTED_H
+
+extern "C" __declspec(dllimport) long __stdcall InterlockedIncrement(long volatile *);
+extern "C" __declspec(dllimport) long __stdcall InterlockedDecrement(long volatile *);
+
+class OpaqueRefCounted
+{
+public:
+    virtual ~OpaqueRefCounted();
+    void Add_Ref() { InterlockedIncrement(&refs); }
+    bool rva00050EFA();
+    void Release_Ref();
+private:
+    long refs;
+};
+
+#endif
