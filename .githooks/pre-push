#!/usr/bin/env bash
# Push gate: static ledger integrity of the outgoing commit + byte-verify of
# every source whose ledger claims changed vs the remote. Repository-wide scopes
# run the ordinary full gate once instead of restarting it for every chunk.
set -euo pipefail
# Incremental mode trusts every object it is not told to rebuild (tools/build.py);
# a gate must judge objects built from what it pushes.
unset BUILD_RECOMPILE_ONLY
# cl.exe reads options from CL and _CL_: a gate builds with the command the receipt records.
unset CL _CL_

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() {
    echo "PRE-PUSH FAILED: $*" >&2
    exit 1
}

# stage NAME: report the seconds since the previous stage on stderr, so a slow push
# shows where its time went (`pre-push: <stage> <seconds>s`). Bash's own clock, no fork.
_stage_clock=${EPOCHREALTIME:-}
stage() {
    [ -n "$_stage_clock" ] || return 0
    local now=$EPOCHREALTIME
    local us=$(( (10#${now/./} - 10#${_stage_clock/./}) ))
    printf 'pre-push: %s %d.%02ds
' "$1" $((us / 1000000)) $((us % 1000000 / 10000)) >&2
    _stage_clock=$now
}

# shadow_cap CMD...: a backstop for a shadow detector, which bounds itself
# (tools/shadow_budget.py, $BFME_SHADOW_BUDGET_S, default 10 s): GNU timeout at the
# budget plus 30 s where it exists (Git Bash, Linux, Wine runners). Windows' own
# timeout.exe is another program, hence the --version probe; without GNU timeout the
# command runs uncapped.
shadow_cap() {
    local cap=${BFME_SHADOW_BUDGET_S:-10}
    cap=${cap%%.*}
    case "$cap" in ''|*[!0-9]*) cap=10 ;; esac
    if [ "$cap" -gt 0 ] && timeout --version >/dev/null 2>&1; then
        timeout -k 5 $((10#$cap + 30)) "$@"
    else
        "$@"
    fi
}

# capture VAR WHAT CMD...: run CMD into a new temp file, store its path in VAR, and fail
# naming WHAT if CMD fails. `< <(cmd)` drops the producer's exit status, so a crashed
# delta_sources read as "nothing to verify" and the push went out unverified.
capture() {
    local captured
    captured=$(mktemp) || fail "temporary file for $2"
    "${@:3}" > "$captured" || { rm -f "$captured"; fail "$2 (see above)"; }
    printf -v "$1" '%s' "$captured"
}

# fast_forward_or_fail REV: the full gate only pays off if REV still fast-forwards
# origin/master; an unreachable origin is left for the push itself to report.
fast_forward_or_fail() {
    git fetch -q origin master 2>/dev/null || return 0
    git merge-base --is-ancestor FETCH_HEAD "$1"         || fail "origin/master moved past this push's base; pull --rebase before running the full gate"
}
# scope_from FROM: the sources a change from FROM to the pushed commit can affect,
# into delta, name_deps, edited, flag_delta and header_range; header_all=1 when
# the include graph cannot bound it. FROM is the remote base, or a commit whose
# full gate passed in this clone (tools/full_gate_receipt.py).
scope_from() {
    local base="$1"
    capture delta_out "delta_sources" python3 tools/delta_sources.py --range "$base" "$local_sha"
    mapfile -t delta < "$delta_out"
    rm -f "$delta_out"
    stage "scope: delta_sources"
    # Units that call a name the range renames, removes or re-addresses (a row
    # or a pin) resolve their call sites through it: verify them too
    # (pre-commit's 3a; tools/name_dependents.py).
    capture name_deps_out "listing the units that call a renamed or removed name" \
        python3 tools/name_dependents.py --range "$base" "$local_sha"
    mapfile -t name_deps < "$name_deps_out"
    rm -f "$name_deps_out"
    stage "scope: name_dependents"

    # Sources the range EDITS while leaving their ledger rows alone are absent
    # from that delta, so nothing byte-verifies them — yet one such edit can
    # break every other row in the same translation unit. Disabling a body
    # (#if 0, or just deleting it) removes the inlines and template
    # instantiations only that body referenced, and sibling rows stop resolving
    # with "symbol not found in object": one assignDefaultGadgetLook orphaned 67
    # rows in GameWindowManager.cpp. pre-commit already byte-verifies every
    # staged Code/*.cpp for exactly this reason; --no-verify skips pre-commit
    # entirely, so the push gate has to repeat it.
    capture edited_out "listing the edited claimed sources" python3 - "$base" "$local_sha" <<'PY'
import csv, io, subprocess, sys
base, rev = sys.argv[1], sys.argv[2]


def git(*argv):
    return subprocess.run(("git",) + argv, capture_output=True, text=True,
                          check=True).stdout


claimed = {r["source"] for r in csv.DictReader(io.StringIO(
    git("show", "%s:reverse/functions.csv" % rev))) if r.get("status") == "matched"}
# a data-only TU owns data_rows.csv rows (tools/data_rows.py): its edits are verified too.
# Only a proven absence (ls-tree lists nothing) means no data rows; a git error fails.
if git("ls-tree", rev, "--", "reverse/data_rows.csv").strip():
    claimed |= {r["source"] for r in csv.DictReader(io.StringIO(
        git("show", "%s:reverse/data_rows.csv" % rev))) if r.get("status") == "matched"}
touched = git("diff", "--name-only", "--diff-filter=ACMRT", base, rev,
              "--", "Code/*.cpp", "Code/*.c", "Code/*.asm").splitlines()
sys.stdout.reconfigure(newline="\n")
for path in sorted(set(touched) & claimed):
    print(path)
PY
    mapfile -t edited < "$edited_out"
    rm -f "$edited_out"
    stage "scope: edited sources"

    capture flag_delta_out "flag_delta_sources" python3 tools/flag_delta_sources.py --range "$base" "$local_sha"
    mapfile -t flag_delta < "$flag_delta_out"
    rm -f "$flag_delta_out"
    stage "scope: flag_delta_sources"

    # Sources a changed header or shim reaches (tools/header_dependents.py, as
    # pre-commit's scoped header gate) are byte-verified with the rest, so the
    # converged data check judges objects whose bytes are retail's. A change the
    # include graph cannot bound is judged below over every source's current object.
    header_range=()
    header_all=0
    header_range_out=$(mktemp)
    if python3 tools/header_dependents.py --range "$base" "$local_sha" > "$header_range_out"; then
        # Only sources owning a matched function or data row: the build refuses a
        # parked draft (no row) as "no functions match".
        claimed_out=$(mktemp)
        tr '\n' '\0' < "$header_range_out" \
            | python3 tools/data_check.py --print-claimed --sources-from - > "$claimed_out" \
            || { rm -f "$header_range_out" "$claimed_out"; fail "filtering header dependents to claimed sources (see above)"; }
        mapfile -d '' -t header_range < "$claimed_out"
        rm -f "$claimed_out"
    else
        header_all=1
    fi
    rm -f "$header_range_out"
    stage "scope: header_dependents"
}

# collect_verify: the scope_from lists, deduplicated in order, into verify.
collect_verify() {
    local s
    local -A seen=()
    verify=()
    for s in "${delta[@]}" "${edited[@]}" "${name_deps[@]}" "${flag_delta[@]}" "${header_range[@]}"; do
        [ -z "$s" ] && continue
        [ -n "${seen[$s]:-}" ] && continue
        seen["$s"]=1
        [ -f "$s" ] || fail "outgoing rows reference missing source $s"
        verify+=("$s")
    done
}

# Landing window (tools/push_lease.py, the claim lease:landing, 30-minute TTL).
# A full-gate or carried push to master takes it before its gate, so scoped
# pushes do not move master under it; every other push to master waits for it
# at the end of this hook, until the holder's commit lands or the TTL passes.
# The hook releases it when it fails; on success it keeps it, because git sends
# the pack after this hook ends (a window released here let a waiter win the
# race anyway). It fails open and never blocks past the TTL.
# BFME_LANDING_LEASE=off skips it.
LANDING_TOKEN=""
landing_ok=0
release_landing_on_failure() {
    if [ -n "$LANDING_TOKEN" ] && [ "$landing_ok" -ne 1 ]; then
        python3 tools/push_lease.py release "$LANDING_TOKEN" >/dev/null 2>&1 || true
        LANDING_TOKEN=""
    fi
}
trap release_landing_on_failure EXIT
landing_enabled() {
    [ "${BFME_LANDING_LEASE:-on}" != "off" ] && [ -f tools/push_lease.py ] \
        && [ "${_remote_ref:-}" = "refs/heads/master" ]
}
take_landing_window() {
    landing_enabled || return 0
    LANDING_TOKEN="$(python3 tools/push_lease.py acquire "$1")" || LANDING_TOKEN=""
    if [ -n "$LANDING_TOKEN" ]; then
        echo "pre-push: holding the landing window (tools/push_lease.py) for $1"
    fi
}
wait_landing_window() {
    landing_enabled || return 0
    python3 tools/push_lease.py wait || true
}

# full_gate_pool: the process pool for a full-gate run. An explicit BUILD_POOL
# wins; otherwise a third of the machine's cores, at least 4 and at most 8 (a
# 24-core seat ran its full gate in 54 minutes at a pool of 2). Scoped builds
# keep their own default.
full_gate_pool() {
    if [ -n "${BUILD_POOL:-}" ]; then
        printf '%s' "$BUILD_POOL"
        return
    fi
    local cores
    cores=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 12)
    case "$cores" in ''|*[!0-9]*) cores=12 ;; esac
    cores=$((cores / 3))
    [ "$cores" -ge 4 ] || cores=4
    [ "$cores" -le 8 ] || cores=8
    printf '%s' "$cores"
}

run_build() {
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) py -3 tools/build.py "$@" ;;
        *) ./build.sh "$@" ;;
    esac
}

# Windows caps a native command line at 32,767 UTF-16 units ("Argument list too
# long"). Twice an argument's UTF-8 length plus quotes and a space bounds its
# quoted size, leaving room for the interpreter and script path.
measure_argument() {
    local LC_ALL=C
    argument_bytes=$((2 * ${#1} + 3))
}
# check_worktree_chunks REV SOURCE...: bind every source to the pushed commit.
# A driver change can select every matched source. Spawning git once per source
# costs minutes on Windows and can exhaust MSYS fork retries before any build.
check_worktree_chunks() {
    local revision="$1" chunk=() chunk_bytes=0 source
    local message="outgoing source chunk differs from the pushed commit $1 in the working tree, or git diff failed; check it out or stash before pushing (see above)"
    shift
    for source in "$@"; do
        measure_argument "$source"
        [ "$argument_bytes" -le 24000 ] || fail "worktree source exceeds argument limit: $source"
        if [ "${#chunk[@]}" -ne 0 ] && [ "$((chunk_bytes + argument_bytes))" -gt 24000 ]; then
            git diff --quiet "$revision" -- "${chunk[@]}" || fail "$message"
            chunk=()
            chunk_bytes=0
        fi
        chunk+=("$source")
        chunk_bytes=$((chunk_bytes + argument_bytes))
    done
    if [ "${#chunk[@]}" -ne 0 ]; then
        git diff --quiet "$revision" -- "${chunk[@]}" || fail "$message"
    fi
}
# build_chunks MESSAGE SELECTOR...: byte-verify every selector, failing with MESSAGE.
build_chunks() {
    local message="$1" chunk=() chunk_bytes=0 selector
    shift
    for selector in "$@"; do
        measure_argument "$selector"
        [ "$argument_bytes" -le 24000 ] || fail "byte-verify selector exceeds argument limit: $selector"
        if [ "${#chunk[@]}" -ne 0 ] && [ "$((chunk_bytes + argument_bytes))" -gt 24000 ]; then
            BUILD_POOL="${BUILD_POOL:-4}" run_build "${chunk[@]}" || fail "$message"
            chunk=()
            chunk_bytes=0
        fi
        chunk+=("$selector")
        chunk_bytes=$((chunk_bytes + argument_bytes))
    done
    if [ "${#chunk[@]}" -ne 0 ]; then
        BUILD_POOL="${BUILD_POOL:-4}" run_build "${chunk[@]}" || fail "$message"
    fi
}

# classify_full_scope REV LIST [FULL_REQUIRED]: choose the ordinary full build
# when LIST covers every matched compileable provider, or an unbounded dependency
# change already requires it. In either case use the pushed ledgers to retain only
# selectors the ordinary full build does not cover. Keep additional selectors
# explicit: a row-less source must still be refused by its scoped build.
# LIST and the result are NUL-delimited so paths never become shell arguments.
classify_full_scope() {
    python3 - "$1" "$2" "${3:-0}" <<'PY'
import csv, io, pathlib, subprocess, sys
rev, listing, full_required = sys.argv[1:]
if full_required not in ("0", "1"):
    raise ValueError("invalid full-build requirement")


def git(*argv):
    return subprocess.run(("git",) + argv, capture_output=True, encoding="utf-8",
                          check=True).stdout


def providers(path):
    rows = csv.DictReader(io.StringIO(git("show", "%s:%s" % (rev, path))), strict=True)
    if not {"source", "status"}.issubset(rows.fieldnames or ()):
        raise ValueError("provider ledger lacks source/status columns: " + path)
    result = set()
    for row in rows:
        if None in row or any(value is None for value in row.values()):
            raise ValueError("malformed provider ledger row: " + path)
        if row["status"] == "matched":
            if not row["source"]:
                raise ValueError("matched provider has no source: " + path)
            if pathlib.PurePosixPath(row["source"]).suffix.lower() in (".c", ".cpp", ".asm"):
                result.add(row["source"])
    return result


raw = pathlib.Path(listing).read_bytes()
if raw and not raw.endswith(b"\0"):
    raise ValueError("unterminated source list")
selected = [path.decode("utf-8") for path in raw.split(b"\0") if path]
required = providers("reverse/functions.csv")
# Missing data_rows.csv is allowed only when Git proves its absence.
if git("ls-tree", rev, "--", "reverse/data_rows.csv").strip():
    required |= providers("reverse/data_rows.csv")
full = full_required == "1" or (bool(required) and required.issubset(selected))
result = ["full"] + [path for path in selected if path not in required] if full else ["chunks"]
sys.stdout.buffer.write(b"".join(path.encode("utf-8") + b"\0" for path in result))
PY
}

# run_final_audits REV BASE LIST COUNT: both audits read the byte-verified objects.
# In an unbounded dependency scope, overlap those independent read-only checks.
# Each receives its complete original scope; wait for both and preserve failures.
run_final_audits() {
    local revision="$1" base="$2" listing="$3" count="$4"
    local eh_out data_out eh_pid="" data_pid eh_status=0 data_status=0
    [ -f "$listing" ] || fail "missing final audit source list"
    case "$count" in ''|*[!0-9]*) fail "invalid final audit source count" ;; esac
    python3 - "$listing" "$count" <<'PY' || fail "incomplete final audit source list"
import pathlib, sys
raw = pathlib.Path(sys.argv[1]).read_bytes()
count = int(sys.argv[2])
if not 0 <= count <= 2**31 - 1:
    raise ValueError("invalid source count")
if count == 0:
    if raw:
        raise ValueError("unexpected source list")
elif not raw.endswith(b"\0") or len(raw.split(b"\0")) - 1 != count or any(not path for path in raw.split(b"\0")[:-1]):
    raise ValueError("incomplete source list")
PY
    eh_out=$(mktemp) || fail "temporary exception audit output"
    data_out=$(mktemp) || { rm -f "$eh_out"; fail "temporary data audit output"; }
    if [ "$count" -ne 0 ]; then
        python3 tools/eh_verify.py --sources-from - < "$listing" > "$eh_out" 2>&1 &
        eh_pid=$!
    fi
    python3 tools/data_check.py --converged --ref "$revision" --converged-base "$base" --all > "$data_out" 2>&1 &
    data_pid=$!
    if [ -n "$eh_pid" ]; then
        wait "$eh_pid" || eh_status=$?
    fi
    wait "$data_pid" || data_status=$?
    if ! cat "$eh_out" "$data_out"; then
        rm -f "$eh_out" "$data_out"
        fail "reading final audit output"
    fi
    rm -f "$eh_out" "$data_out"
    [ "$eh_status" -eq 0 ] || fail "exception data differs from retail in outgoing sources (see above)"
    [ "$data_status" -eq 0 ] || fail "data identity: a second name for a converged data address (every source, see above)"
}

refs="$(cat || true)"

ZERO=0000000000000000000000000000000000000000

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    # Shared work claims are empty-tree marker commits, not game-source commits;
    # so are leftover publish-window refs (refs/landing/*), which no gate reads.
    case "${_remote_ref:-}" in refs/claims/*|refs/landing/*) continue ;; esac
    # Hosts whose git proxy only accepts branch pushes keep claims under
    # refs/heads/claims/ (bfme.claimNamespace, tools/claims.py). A branch there
    # skips the gate only while it carries the empty-tree marker; anything with
    # files is judged like any other push.
    case "${_remote_ref:-}" in
        refs/heads/claims/*)
            [ "$(git rev-parse -q --verify "$local_sha^{tree}" 2>/dev/null)" = 4b825dc642cb6eb9a060e54bf8d69288fbee4904 ] && continue ;;
    esac
    [ "$local_sha" = "$ZERO" ] && continue   # deleting a remote ref
    # The build below reads the working-tree ledgers: they must be the pushed commit's.
    python3 tools/ledger_guard.py --commit "$local_sha" || fail "working-tree ledgers differ from $local_sha (see above)"
    stage "ledger_guard"
    # Every gate below reads the ledgers by exact spelling: one tracked under
    # another case (Reverse/data_rows.csv) is served to the build by a
    # case-insensitive file system while those lookups miss it.
    python3 tools/check_case_collisions.py --ref "$local_sha" \
        || fail "case-only path collision, or a control path not in lowercase, in $local_sha (see above)"
    stage "check_case_collisions"

    python3 tools/check_csv.py --ref "$local_sha" || fail "ledger integrity at $local_sha (see above)"
    stage "check_csv"

    if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha" 2>/dev/null; then
        base="$remote_sha"
    else
        base="$(git merge-base "$local_sha" origin/master 2>/dev/null || true)"
    fi
    if [ -z "$base" ]; then
        echo "pre-push: no known remote base; static ledger check only" >&2
        continue
    fi

    # Empty commits: one parent, and that parent's tree. A seat re-landing work that is
    # already on master pushed 57 of them on 2026-10-08..12 (277bfd21a8 landed, then 14
    # empty copies of it); every gate below passes a commit that changes no file. One git log.
    python3 tools/empty_commits.py --range "$base" "$local_sha" || fail "empty commit(s) in the outgoing range (see above)"
    stage "empty_commits"

    # Direction gate over the OUTGOING range, same call verify_pr.sh makes on a
    # PR. pre-commit runs it too, but --no-verify and clones that never ran
    # tools/setup_hooks.sh skip that entirely, and the byte-verify below cannot
    # see a backward conversion: an __emit spray of retail bytes byte-matches BY
    # CONSTRUCTION. 89 lift commits reached origin through exactly this gap.
    # Runs before the build because it costs a second and the build costs minutes.
    python3 tools/conversion_gate.py "$base" "$local_sha" || fail "conversion direction (see above)"
    stage "conversion_gate"

    # Identity, for the same reason conversion_gate runs here: byte-verification
    # cannot see it. reverse/symbols.csv is an ADDITIVE candidate list, so a pin
    # naming the WRONG function still reproduces its caller's bytes and every
    # scoped build below stays green. Small pushes do not run the full gate, so
    # they must run this identity check explicitly as well. 1.6s.
    python3 tools/pin_consistency.py --check || fail "pin consistency (see above)"
    python3 tools/pin_consistency.py --assert-shrink-only "$base" --at "$local_sha" \
        || fail "pin_consistency_baseline.csv grew across the outgoing range (see above)"
    stage "pin_consistency"
    # Verifier code and baselines: every outgoing commit that changes one
    # carries a Verifier-Change trailer, and shrink-only lists do not grow.
    # Judged by the checker as of the remote tip, so an outgoing edit to the
    # checker cannot approve itself.
    if git cat-file -e "$base:tools/protected_paths.py" 2>/dev/null; then
        git show "$base:tools/protected_paths.py" | python3 - --range "$base" "$local_sha" \
            || fail "protected verifier/baseline change in outgoing range (see above)"
    elif git cat-file -e "$local_sha:tools/protected_paths.py" 2>/dev/null; then
        git show "$local_sha:tools/protected_paths.py" | python3 - --range "$base" "$local_sha" \
            || fail "protected verifier/baseline change in outgoing range (see above)"
    fi
    stage "protected_paths"
    # Recheck retirement even when commit-time hooks were skipped. Use the remote
    # implementation when available, and judge outgoing blobs/messages, not the index.
    capture debt_changes_out "listing outgoing debt-register changes" \
        git diff --name-only "$base" "$local_sha" -- reverse/gate_baseline.txt \
        reverse/data_check_baseline.txt reverse/code_identity_baseline.tsv reverse/header_queue.tsv
    if [ -s "$debt_changes_out" ]; then
        debt_checker=$(mktemp)
        if git cat-file -e "$base:tools/repair_queue.py" 2>/dev/null; then
            git show "$base:tools/repair_queue.py" > "$debt_checker"
        else
            git show "$local_sha:tools/repair_queue.py" > "$debt_checker" \
                || { rm -f "$debt_checker"; fail "loading outgoing debt checker"; }
        fi
        # Bootstrap the range-aware check when the remote predates it. Thereafter
        # the remote's copy judges its own replacement, like protected_paths above.
        if ! grep -q 'def verify_debt_range(' "$debt_checker"; then
            git show "$local_sha:tools/repair_queue.py" > "$debt_checker" \
                || { rm -f "$debt_checker"; fail "loading range-aware debt checker"; }
        fi
        if grep -q 'def verify_debt_range(' "$debt_checker"; then
            python3 - verify-removed --range "$base" "$local_sha" < "$debt_checker" \
                || { rm -f "$debt_checker"; fail "retired debt has no passing outgoing verdict (see above)"; }
            python3 - verify-missing --range "$base" "$local_sha" < "$debt_checker" \
                || { rm -f "$debt_checker"; fail "disappearing outgoing debt has no accounting (see above)"; }
        else
            rm -f "$debt_checker"
            fail "remote debt checker lacks outgoing-range verification; update the verifier first"
        fi
        rm -f "$debt_checker"
    fi
    rm -f "$debt_changes_out"
    stage "debt registers"
    python3 tools/pin_admission.py --range "$base" "$local_sha" \
        || fail "pin/alias admission across the outgoing range (see above)"
    stage "pin_admission"
    if git cat-file -e "$base:tools/gate_baseline.py" 2>/dev/null; then
        git show "$base:tools/gate_baseline.py" | python3 - --range "$base" "$local_sha" \
            || fail "gate_baseline.txt grew across the outgoing range (see above)"
    fi
    stage "gate_baseline"

    python3 tools/eh_verify.py --assert-shrink-range "$base" "$local_sha" \
        || fail "eh_baseline.csv grew across the outgoing range (see above)"
    stage "eh shrink-only"

    # The build below reads the working tree: bind it to the pushed commit for every
    # file the push changes and every tracked header or shim, so an edit left on
    # disk cannot stand in for what is pushed (the converged data check below reads
    # the same objects). An untracked file is not covered; see tools/data_check.py.
    capture range_files_out "listing the files the push changes" git diff --name-only -z "$base" "$local_sha"
    mapfile -d '' -t range_files < "$range_files_out"
    rm -f "$range_files_out"
    if [ "${#range_files[@]}" -ne 0 ]; then
        printf '%s\0' "${range_files[@]}" | xargs -0 git diff --quiet "$local_sha" -- \
            || fail "the working tree differs from $local_sha in files this push changes: commit or stash first"
    fi
    git diff --quiet "$local_sha" -- '*.h' '*.hpp' '*.hh' '*.hxx' '*.inl' '*.inc' reference/shims vendor/stlport-4.6 vendor/stlport-4.6-bfme tools/stlport_overlay.py \
        || fail "a tracked header or shim differs from $local_sha in the working tree: commit or stash it first"
    stage "working tree binding"

    scope_from "$base"
    collect_verify
    # Carried full gate: a commit of this push whose full gate already passed in this
    # clone (a push git rejected because master moved) is verified again only where it
    # differs from that commit, the way a push from it would be (tools/full_gate_receipt.py).
    # Asked for an unbounded dependency change or at least 512 sources: even a
    # bounded header scope below the full-build threshold can take minutes on Windows.
    carried=""
    carried_dir=""
    dir32_index=""
    gate_loads=""
    large_scope=0
    if [ "$header_all" -ne 0 ] || [ "${#verify[@]}" -ge 512 ]; then
        large_scope=1
        carried="$(python3 tools/full_gate_receipt.py find "$local_sha")" || carried=""
    fi
    stage "receipt lookup"
    if [ -n "$carried" ]; then
        echo "pre-push: $carried passed the full gate in this clone; verifying what differs from it"
        scope_from "$carried"
        [ "$header_all" -eq 0 ] || fail "carried full gate from $carried is unbounded"
        collect_verify
    fi
    # A full-gate or carried push takes the landing window before its gate; a
    # retry by the holder renews it (tools/push_lease.py).
    if [ "$large_scope" -ne 0 ]; then
        take_landing_window "$local_sha"
        stage "landing window"
    fi
    # The pushed commit, not HEAD: a push of an older commit builds what it pushes.
    check_worktree_chunks "$local_sha" "${verify[@]}"
    stage "source binding"
    # Verify in chunks: a first push of a branch whose remote ref does not exist
    # yet falls back to merge-base, which on a fork rebased onto a much newer
    # upstream can list thousands of sources. Windows caps the argument list, so
    # one giant ./build.sh call dies with "Argument list too long" and the push
    # fails for an environment reason rather than a byte mismatch. A fixed count
    # of 200 sources still overflows once their paths average ~160 characters.
    full_scope=0
    extra=()
    # An unbounded dependency change already requires a full gate. Otherwise
    # prove a large bounded scope covers all providers before choosing it. In
    # both cases keep only selectors outside the full build as additional work.
    if [ "$header_all" -ne 0 ] || [ "${#verify[@]}" -ge 1024 ]; then
        verify_list=$(mktemp) || fail "temporary source list"
        printf '%s\0' "${verify[@]}" > "$verify_list"
        capture scope_out "proving full build scope" classify_full_scope "$local_sha" "$verify_list" "$header_all"
        mapfile -d '' -t scope < "$scope_out"
        rm -f "$scope_out" "$verify_list"
        case "${scope[0]:-}" in
            full) full_scope=1; extra=("${scope[@]:1}") ;;
            chunks) ;;
            *) fail "invalid full build scope result" ;;
        esac
    fi
    if [ "$full_scope" -ne 0 ]; then
        git diff --quiet "$local_sha" -- Code \
            || fail "a tracked source differs from the pushed commit $local_sha in the working tree: check it out or stash first"
        if [ "${_remote_ref:-}" = "refs/heads/master" ]; then
            fast_forward_or_fail "$local_sha"
        fi
        echo "pre-push: full provider scope required; running the ordinary full gate once"
        # build.py logs the tools/ files this gate loads; the receipt keeps the list
        # so a later change to a tool the gate never ran does not void it.
        gate_loads="$(mktemp -d)" || fail "temporary directory for the full gate's tool list"
        gate_loads="$(cygpath -m "$gate_loads" 2>/dev/null || printf '%s' "$gate_loads")"
        export BFME_GATE_LOADS="$gate_loads"
        # The DIR32 check's per-row index, kept with the receipt: a carried retry
        # reads again only the objects it verifies (tools/full_gate_receipt.py).
        # Its own directory: everything in $gate_loads is read as build.py's
        # tool logs (a136856afb's receipt failed on the gzip index there).
        carried_dir=$(mktemp -d) || fail "temporary directory for the DIR32 index"
        carried_dir="$(cygpath -m "$carried_dir" 2>/dev/null || printf '%s' "$carried_dir")"
        dir32_index="$carried_dir/dir32-index.gz"
        export BFME_DIR32_INDEX="$dir32_index"
        BUILD_POOL="$(full_gate_pool)" run_build \
            || fail "full byte-verify of outgoing sources (see above)"
        unset BFME_DIR32_INDEX
        build_chunks "byte-verify of additional outgoing sources (see above)" "${extra[@]}"
        unset BFME_GATE_LOADS
    else
        build_chunks "byte-verify of outgoing sources (see above)" "${verify[@]}"
    fi
    stage "byte-verify (${#verify[@]} sources, full=$full_scope)"
    # A scoped push's DIR32 consistency: its verified rows with a few current
    # witness rows per symbol they address (build.scoped_dir32). The cross-row
    # check otherwise ran only in a full gate, and 86dd4a6165 landed a unit
    # whose rows stayed exact while two resolved one static to two addresses.
    # A full or carried gate runs the whole check instead.
    if [ "$full_scope" -eq 0 ] && [ -z "$carried" ] && [ "${#verify[@]}" -ne 0 ]; then
        scoped_list=$(mktemp) || fail "temporary scoped DIR32 source list"
        printf '%s\0' "${verify[@]}" > "$scoped_list" || { rm -f "$scoped_list"; fail "writing the scoped DIR32 list"; }
        scoped_status=0
        python3 tools/full_gate_receipt.py scoped-dir32 --verified-from "$scoped_list" --ref "$local_sha" \
            || scoped_status=$?
        rm -f "$scoped_list"
        [ "$scoped_status" -eq 0 ] || fail "DIR32 consistency over the outgoing sources failed (see above)"
        stage "scoped DIR32"
    fi
    # A carried full gate keeps the full gate's tree-wide checks: the checks that
    # compare sources with each other run over every row, and an exception-data or
    # converged-data list that changed since the carried commit is audited over
    # every source (tools/full_gate_receipt.py).
    if [ -n "$carried" ]; then
        git diff --quiet "$local_sha" -- Code             || fail "a tracked source differs from the pushed commit $local_sha in the working tree: check it out or stash first"
        # Every row is judged; only the objects this push verified are read again,
        # the rest keep the carried check's DIR32 pairs while their ledger key and
        # object stamp are unchanged (anything unproven checks every row).
        carried_dir=$(mktemp -d) || fail "temporary directory for the carried cross-checks"
        carried_dir="$(cygpath -m "$carried_dir" 2>/dev/null || printf '%s' "$carried_dir")"
        : > "$carried_dir/verified" || fail "writing the verified source list"
        if [ "${#verify[@]}" -ne 0 ]; then
            printf '%s\0' "${verify[@]}" > "$carried_dir/verified" || fail "writing the verified source list"
        fi
        dir32_index="$carried_dir/dir32-index.gz"
        BUILD_POOL="$(full_gate_pool)" python3 tools/full_gate_receipt.py cross-checks --since "$carried" \
            --verified-from "$carried_dir/verified" --index-out "$dir32_index" \
            || fail "cross-source checks over every row (carried full gate; see above)"
        if ! git diff --quiet "$carried" "$local_sha" -- reverse/eh_baseline.csv; then
            python3 tools/eh_verify.py --all                 || fail "exception data differs from retail (eh_baseline.csv changed since $carried; see above)"
        fi
        if ! git diff --quiet "$carried" "$local_sha" -- reverse/data_converged.csv; then
            python3 tools/data_check.py --converged --all --ref "$local_sha" --converged-base "$base"                 || fail "data identity over every source (data_converged.csv changed since $carried; see above)"
        fi
    fi
    stage "carried cross-checks"
    # Data identity at converged addresses, ENFORCED: all sources for an
    # unbounded dependency change, otherwise exactly the byte-verified scope.
    if [ "$header_all" -ne 0 ]; then
        git diff --quiet "$local_sha" -- Code \
            || fail "a tracked source differs from the pushed commit $local_sha in the working tree: check it out or stash first"
        final_list=$(mktemp) || fail "temporary final audit source list"
        if [ "${#verify[@]}" -ne 0 ]; then
            printf '%s\0' "${verify[@]}" > "$final_list" || { rm -f "$final_list"; fail "writing final audit source list"; }
        fi
        run_final_audits "$local_sha" "$base" "$final_list" "${#verify[@]}"
        rm -f "$final_list"
    else
        if [ "${#verify[@]}" -ne 0 ]; then
            printf '%s\0' "${verify[@]}" | python3 tools/eh_verify.py --sources-from - \
                || fail "exception data differs from retail in outgoing sources (see above)"
        fi
        printf '%s\0' "${verify[@]}" \
            | python3 tools/data_check.py --converged --ref "$local_sha" --converged-base "$base" --sources-from - \
            || fail "data identity: a second name for a converged data address in outgoing sources (see above)"
    fi
    stage "eh + data audits"
    # Fail proven link regressions. Stale or missing evidence stays explicitly
    # inconclusive; it cannot establish either a regression or a clean result.
    link_scope=$(mktemp) || fail "temporary link audit source list"
    if [ "${#verify[@]}" -ne 0 ]; then
        printf '%s\0' "${verify[@]}" > "$link_scope"
    fi
    link_status=0
    BFME_SHADOW_BUDGET_S=60 shadow_cap python3 tools/link_batch_audit.py \
        --base "$base" --tip "$local_sha" --sources-from "$link_scope" < /dev/null \
        || link_status=$?
    rm -f "$link_scope"
    case "$link_status" in
        0) ;;
        1) fail "linking regression in the outgoing batch (see above)" ;;
        2|124|137) echo "pre-push: linking UNVERIFIED; audit evidence incomplete or check timed out" >&2 ;;
        *) fail "link batch audit failed to run (exit $link_status)" ;;
    esac
    stage "link_batch_audit"
    # Replayed commits, SHADOW: an outgoing commit with the author, author date and
    # subject of one already upstream (a possible replay), or whose patch-id or added
    # ledger lines are already there (a replay). Seats re-pushed old commits 3,541 times
    # on 2026-10-06..08, each a duplicate row every byte gate passes. About a second for
    # a typical push, ~4 s for 2,000 commits; bounded by $BFME_SHADOW_BUDGET_S (default
    # 10 s), then shadow_cap. Reports, never fails the push.
    shadow_cap python3 tools/replay_check.py --shadow --range "$base" "$local_sha" < /dev/null \
        || echo "pre-push: replay_check shadow check failed to run (ignored)" >&2
    stage "replay_check"
    # A bounded scope of 512+ sources can also lose the race with master while
    # its chunks run, so it is recorded after all required checks pass. A rebased retry
    # carries it under the same verifier and dependency guards as a full gate.
    # A carried push that passed is recorded too: it verified what changed since its
    # receipt plus the every-row cross-checks, so the next retry carries from this
    # nearer commit instead of re-verifying an ever larger delta from an old one.
    # The receipt keeps the tools its full gate loaded (a carried push inherits them).
    if [ "$full_scope" -ne 0 ] || [ "$large_scope" -ne 0 ]; then
        python3 tools/full_gate_receipt.py record "$local_sha" --loads "${gate_loads:-}" \
            --base "$base" ${carried:+--loads-from "$carried"} ${dir32_index:+--dir32-index "$dir32_index"} \
            || echo "pre-push: could not record the full gate for $local_sha (a retry runs it again)" >&2
        [ -z "${gate_loads:-}" ] || rm -rf "$gate_loads"
    fi
    [ -z "${carried_dir:-}" ] || rm -rf "$carried_dir"
    stage "receipt record"
    # Any other push waits while another seat lands a full-gate push.
    if [ "$large_scope" -eq 0 ]; then
        wait_landing_window
        stage "landing window wait"
    fi
    echo "PRE-PUSH OK (${#verify[@]} outgoing source(s) byte-verified)"
done <<< "$refs"
# Publisher rollout (tools/publisher_hook.py; mode in reverse/publisher_mode): shadow submits the landed range as a unit in the background and never fails the push; enforce queues it and refuses (exit 3).
[ ! -f tools/publisher_hook.py ] || [ -n "${CHECKER_DIGEST:-}" ] || python3 tools/publisher_hook.py pre-push "${1:-origin}" <<< "$refs" || [ $? != 3 ] || exit 1
stage "publisher_hook"
# Passed: keep the landing window for git's push of the pack (it lapses or counts
# as free once origin/master holds the commit).
landing_ok=1
