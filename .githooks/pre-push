#!/usr/bin/env bash
# Push gate: static ledger integrity of the outgoing commit + byte-verify of
# every source whose ledger claims changed vs the remote. Bounded by push size
# — never the full gate.
set -euo pipefail
# Incremental mode trusts every object it is not told to rebuild (tools/build.py);
# a gate must judge objects built from what it pushes.
unset BUILD_RECOMPILE_ONLY
# cl.exe reads options from CL and _CL_: a gate builds with the command the receipt records.
unset CL _CL_

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() {
    echo "PRE-PUSH FAILED: $*" >&2
    exit 1
}

# shadow_cap CMD...: a backstop for a shadow detector, which bounds itself
# (tools/shadow_budget.py, $BFME_SHADOW_BUDGET_S, default 10 s): GNU timeout at the
# budget plus 30 s where it exists (Git Bash, Linux, Wine runners). Windows' own
# timeout.exe is another program, hence the --version probe; without GNU timeout the
# command runs uncapped.
shadow_cap() {
    local cap=${BFME_SHADOW_BUDGET_S:-10}
    cap=${cap%%.*}
    case "$cap" in ''|*[!0-9]*) cap=10 ;; esac
    if [ "$cap" -gt 0 ] && timeout --version >/dev/null 2>&1; then
        timeout -k 5 $((10#$cap + 30)) "$@"
    else
        "$@"
    fi
}

# capture VAR WHAT CMD...: run CMD into a new temp file, store its path in VAR, and fail
# naming WHAT if CMD fails. `< <(cmd)` drops the producer's exit status, so a crashed
# delta_sources read as "nothing to verify" and the push went out unverified.
capture() {
    local captured
    captured=$(mktemp) || fail "temporary file for $2"
    "${@:3}" > "$captured" || { rm -f "$captured"; fail "$2 (see above)"; }
    printf -v "$1" '%s' "$captured"
}

run_build() {
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) py -3 tools/build.py "$@" ;;
        *) ./build.sh "$@" ;;
    esac
}

# Windows caps a native command line at 32,767 UTF-16 units ("Argument list too
# long"). Twice an argument's UTF-8 length plus quotes and a space bounds its
# quoted size, leaving room for the interpreter and script path.
measure_argument() {
    local LC_ALL=C
    argument_bytes=$((2 * ${#1} + 3))
}
# build_chunks MESSAGE SELECTOR...: byte-verify every selector, failing with MESSAGE.
build_chunks() {
    local message="$1" chunk=() chunk_bytes=0 selector
    shift
    for selector in "$@"; do
        measure_argument "$selector"
        [ "$argument_bytes" -le 24000 ] || fail "byte-verify selector exceeds argument limit: $selector"
        if [ "${#chunk[@]}" -ne 0 ] && [ "$((chunk_bytes + argument_bytes))" -gt 24000 ]; then
            BUILD_POOL="${BUILD_POOL:-4}" run_build "${chunk[@]}" || fail "$message"
            chunk=()
            chunk_bytes=0
        fi
        chunk+=("$selector")
        chunk_bytes=$((chunk_bytes + argument_bytes))
    done
    if [ "${#chunk[@]}" -ne 0 ]; then
        BUILD_POOL="${BUILD_POOL:-4}" run_build "${chunk[@]}" || fail "$message"
    fi
}

refs="$(cat || true)"

ZERO=0000000000000000000000000000000000000000

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    # Shared work claims are empty-tree marker commits, not game-source commits.
    case "${_remote_ref:-}" in refs/claims/*) continue ;; esac
    [ "$local_sha" = "$ZERO" ] && continue   # deleting a remote ref
    # The build below reads the working-tree ledgers: they must be the pushed commit's.
    python3 tools/ledger_guard.py --commit "$local_sha" || fail "working-tree ledgers differ from $local_sha (see above)"
    # Every gate below reads the ledgers by exact spelling: one tracked under
    # another case (Reverse/data_rows.csv) is served to the build by a
    # case-insensitive file system while those lookups miss it.
    python3 tools/check_case_collisions.py --ref "$local_sha" \
        || fail "case-only path collision, or a control path not in lowercase, in $local_sha (see above)"

    python3 tools/check_csv.py --ref "$local_sha" || fail "ledger integrity at $local_sha (see above)"

    if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha" 2>/dev/null; then
        base="$remote_sha"
    else
        base="$(git merge-base "$local_sha" origin/master 2>/dev/null || true)"
    fi
    if [ -z "$base" ]; then
        echo "pre-push: no known remote base; static ledger check only" >&2
        continue
    fi

    # Direction gate over the OUTGOING range, same call verify_pr.sh makes on a
    # PR. pre-commit runs it too, but --no-verify and clones that never ran
    # tools/setup_hooks.sh skip that entirely, and the byte-verify below cannot
    # see a backward conversion: an __emit spray of retail bytes byte-matches BY
    # CONSTRUCTION. 89 lift commits reached origin through exactly this gap.
    # Runs before the build because it costs a second and the build costs minutes.
    python3 tools/conversion_gate.py "$base" "$local_sha" || fail "conversion direction (see above)"

    # Identity, for the same reason conversion_gate runs here: byte-verification
    # cannot see it. reverse/symbols.csv is an ADDITIVE candidate list, so a pin
    # naming the WRONG function still reproduces its caller's bytes and every
    # scoped build below stays green. This guard only ever ran in the full gate,
    # which no hook path reaches — pre-commit runs it for header/shim changes
    # only, and this hook is bounded by push size and never full — so a wrong
    # pin could reach origin without one check ever looking at it. 1.6s.
    python3 tools/pin_consistency.py --check || fail "pin consistency (see above)"
    python3 tools/pin_consistency.py --assert-shrink-only "$base" --at "$local_sha" \
        || fail "pin_consistency_baseline.csv grew across the outgoing range (see above)"
    # Verifier code and baselines: every outgoing commit that changes one
    # carries a Verifier-Change trailer, and shrink-only lists do not grow.
    # Judged by the checker as of the remote tip, so an outgoing edit to the
    # checker cannot approve itself.
    if git cat-file -e "$base:tools/protected_paths.py" 2>/dev/null; then
        git show "$base:tools/protected_paths.py" | python3 - --range "$base" "$local_sha" \
            || fail "protected verifier/baseline change in outgoing range (see above)"
    elif git cat-file -e "$local_sha:tools/protected_paths.py" 2>/dev/null; then
        git show "$local_sha:tools/protected_paths.py" | python3 - --range "$base" "$local_sha" \
            || fail "protected verifier/baseline change in outgoing range (see above)"
    fi
    python3 tools/pin_admission.py --range "$base" "$local_sha" \
        || fail "pin/alias admission across the outgoing range (see above)"
    if git cat-file -e "$base:tools/gate_baseline.py" 2>/dev/null; then
        git show "$base:tools/gate_baseline.py" | python3 - --range "$base" "$local_sha" \
            || fail "gate_baseline.txt grew across the outgoing range (see above)"
    fi

    python3 tools/eh_verify.py --assert-shrink-range "$base" "$local_sha" \
        || fail "eh_baseline.csv grew across the outgoing range (see above)"

    capture delta_out "delta_sources" python3 tools/delta_sources.py --range "$base" "$local_sha"
    mapfile -t delta < "$delta_out"
    rm -f "$delta_out"
    # Units that call a name the range renames, removes or re-addresses (a row
    # or a pin) resolve their call sites through it: verify them too
    # (pre-commit's 3a; tools/name_dependents.py).
    capture name_deps_out "listing the units that call a renamed or removed name" \
        python3 tools/name_dependents.py --range "$base" "$local_sha"
    mapfile -t name_deps < "$name_deps_out"
    rm -f "$name_deps_out"

    # Sources the range EDITS while leaving their ledger rows alone are absent
    # from that delta, so nothing byte-verifies them — yet one such edit can
    # break every other row in the same translation unit. Disabling a body
    # (#if 0, or just deleting it) removes the inlines and template
    # instantiations only that body referenced, and sibling rows stop resolving
    # with "symbol not found in object": one assignDefaultGadgetLook orphaned 67
    # rows in GameWindowManager.cpp. pre-commit already byte-verifies every
    # staged Code/*.cpp for exactly this reason; --no-verify skips pre-commit
    # entirely, so the push gate has to repeat it.
    capture edited_out "listing the edited claimed sources" python3 - "$base" "$local_sha" <<'PY'
import csv, io, subprocess, sys
base, rev = sys.argv[1], sys.argv[2]


def git(*argv):
    return subprocess.run(("git",) + argv, capture_output=True, text=True,
                          check=True).stdout


claimed = {r["source"] for r in csv.DictReader(io.StringIO(
    git("show", "%s:reverse/functions.csv" % rev))) if r.get("status") == "matched"}
# a data-only TU owns data_rows.csv rows (tools/data_rows.py): its edits are verified too.
# Only a proven absence (ls-tree lists nothing) means no data rows; a git error fails.
if git("ls-tree", rev, "--", "reverse/data_rows.csv").strip():
    claimed |= {r["source"] for r in csv.DictReader(io.StringIO(
        git("show", "%s:reverse/data_rows.csv" % rev))) if r.get("status") == "matched"}
touched = git("diff", "--name-only", "--diff-filter=ACMRT", base, rev,
              "--", "Code/*.cpp", "Code/*.c", "Code/*.asm").splitlines()
sys.stdout.reconfigure(newline="\n")
for path in sorted(set(touched) & claimed):
    print(path)
PY
    mapfile -t edited < "$edited_out"
    rm -f "$edited_out"

    capture flag_delta_out "flag_delta_sources" python3 tools/flag_delta_sources.py --range "$base" "$local_sha"
    mapfile -t flag_delta < "$flag_delta_out"
    rm -f "$flag_delta_out"

    # The build below reads the working tree: bind it to the pushed commit for every
    # file the push changes and every tracked header or shim, so an edit left on
    # disk cannot stand in for what is pushed (the converged data check below reads
    # the same objects). An untracked file is not covered; see tools/data_check.py.
    capture range_files_out "listing the files the push changes" git diff --name-only -z "$base" "$local_sha"
    mapfile -d '' -t range_files < "$range_files_out"
    rm -f "$range_files_out"
    if [ "${#range_files[@]}" -ne 0 ]; then
        printf '%s\0' "${range_files[@]}" | xargs -0 git diff --quiet "$local_sha" -- \
            || fail "the working tree differs from $local_sha in files this push changes: commit or stash first"
    fi
    git diff --quiet "$local_sha" -- '*.h' '*.hpp' '*.hh' '*.hxx' '*.inl' '*.inc' reference/shims \
        || fail "a tracked header or shim differs from $local_sha in the working tree: commit or stash it first"

    # Sources a changed header or shim reaches (tools/header_dependents.py, as
    # pre-commit's scoped header gate) are byte-verified with the rest, so the
    # converged data check judges objects whose bytes are retail's. A change the
    # include graph cannot bound is judged below over every source's current object.
    header_range=()
    header_all=0
    header_range_out=$(mktemp)
    if python3 tools/header_dependents.py --range "$base" "$local_sha" > "$header_range_out"; then
        # Only sources owning a matched function or data row: the build refuses a
        # parked draft (no row) as "no functions match".
        claimed_out=$(mktemp)
        tr '\n' '\0' < "$header_range_out" \
            | python3 tools/data_check.py --print-claimed --sources-from - > "$claimed_out" \
            || { rm -f "$header_range_out" "$claimed_out"; fail "filtering header dependents to claimed sources (see above)"; }
        mapfile -d '' -t header_range < "$claimed_out"
        rm -f "$claimed_out"
    else
        header_all=1
    fi
    rm -f "$header_range_out"

    verify=()
    declare -A seen=()
    for s in "${delta[@]}" "${edited[@]}" "${name_deps[@]}" "${flag_delta[@]}" "${header_range[@]}"; do
        [ -z "$s" ] && continue
        [ -n "${seen[$s]:-}" ] && continue
        seen["$s"]=1
        [ -f "$s" ] || fail "outgoing rows reference missing source $s"
        # The pushed commit, not HEAD: a push of an older commit builds what it pushes.
        git diff --quiet "$local_sha" -- "$s" \
            || fail "$s differs from the pushed commit $local_sha in the working tree; check it out or stash before pushing"
        verify+=("$s")
    done
    # Verify in chunks: a first push of a branch whose remote ref does not exist
    # yet falls back to merge-base, which on a fork rebased onto a much newer
    # upstream can list thousands of sources. Windows caps the argument list, so
    # one giant ./build.sh call dies with "Argument list too long" and the push
    # fails for an environment reason rather than a byte mismatch. A fixed count
    # of 200 sources still overflows once their paths average ~160 characters.
    build_chunks "byte-verify of outgoing sources (see above)" "${verify[@]}"
    if [ "${#verify[@]}" -ne 0 ]; then
        printf '%s\0' "${verify[@]}" | python3 tools/eh_verify.py --sources-from - \
            || fail "exception data differs from retail in outgoing sources (see above)"
    fi
    # Data identity at converged addresses, ENFORCED (pre-commit step 3b): every
    # byte-verified source above, header dependents included, judged on objects
    # proven current; the list as of the pushed commit, which may only grow.
    if [ "$header_all" -ne 0 ]; then
        git diff --quiet "$local_sha" -- Code \
            || fail "a tracked source differs from the pushed commit $local_sha in the working tree: check it out or stash first"
        python3 tools/data_check.py --converged --ref "$local_sha" --converged-base "$base" --all \
            || fail "data identity: a second name for a converged data address (every source, see above)"
    else
        printf '%s\0' "${verify[@]}" \
            | python3 tools/data_check.py --converged --ref "$local_sha" --converged-base "$base" --sources-from - \
            || fail "data identity: a second name for a converged data address in outgoing sources (see above)"
    fi
    # Replayed commits, SHADOW: an outgoing commit with the author, author date and
    # subject of one already upstream (a possible replay), or whose patch-id or added
    # ledger lines are already there (a replay). Seats re-pushed old commits 3,541 times
    # on 2026-10-06..08, each a duplicate row every byte gate passes. About a second for
    # a typical push, ~4 s for 2,000 commits; bounded by $BFME_SHADOW_BUDGET_S (default
    # 10 s), then shadow_cap. Reports, never fails the push.
    shadow_cap python3 tools/replay_check.py --shadow --range "$base" "$local_sha" < /dev/null \
        || echo "pre-push: replay_check shadow check failed to run (ignored)" >&2
    echo "PRE-PUSH OK (${#verify[@]} outgoing source(s) byte-verified)"
done <<< "$refs"
# Publisher rollout (tools/publisher_hook.py; mode in reverse/publisher_mode): shadow submits the landed range as a unit in the background and never fails the push; enforce queues it and refuses (exit 3).
[ ! -f tools/publisher_hook.py ] || [ -n "${CHECKER_DIGEST:-}" ] || python3 tools/publisher_hook.py pre-push "${1:-origin}" <<< "$refs" || [ $? != 3 ] || exit 1
