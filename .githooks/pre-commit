#!/usr/bin/env bash
# Commit gate: static ledger integrity plus byte-verification of the delta.
# Header and shim changes automatically receive the full gate; pre-push checks
# the outgoing delta again. Never bypass this hook.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() {
    echo "PRE-COMMIT FAILED: $*" >&2
    exit 1
}

# capture VAR WHAT CMD...: run CMD into a new temp file, store its path in VAR, and fail
# naming WHAT if CMD fails. `< <(cmd)` and `$(cmd)` drop the producer's exit status, so a
# crashed lister read as an empty list and the hook verified less instead of refusing.
capture() {
    local captured
    captured=$(mktemp) || fail "temporary file for $2"
    "${@:3}" > "$captured" || { rm -f "$captured"; fail "$2 (see above)"; }
    printf -v "$1" '%s' "$captured"
}

run_build() {
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) py -3 tools/build.py "$@" ;;
        *) ./build.sh "$@" ;;
    esac
}

# Windows caps a native command line at 32,767 UTF-16 units; past it Bash
# reports "Argument list too long" and the hook dies on a large commit. Lists
# reach Python on stdin; the build, which takes selectors only as arguments,
# runs in chunks. Twice an argument's UTF-8 length plus quotes and a space
# bounds its quoted size, leaving room for the interpreter and script path.
measure_argument() {
    local LC_ALL=C
    argument_bytes=$((2 * ${#1} + 3))
}
# build_chunks MESSAGE SELECTOR...: byte-verify every selector, failing with MESSAGE.
build_chunks() {
    local message="$1" chunk=() chunk_bytes=0 selector
    shift
    for selector in "$@"; do
        measure_argument "$selector"
        [ "$argument_bytes" -le 24000 ] || fail "byte-verify selector exceeds argument limit: $selector"
        if [ "${#chunk[@]}" -ne 0 ] && [ "$((chunk_bytes + argument_bytes))" -gt 24000 ]; then
            BUILD_POOL="${BUILD_POOL:-4}" run_build "${chunk[@]}" || fail "$message"
            chunk=()
            chunk_bytes=0
        fi
        chunk+=("$selector")
        chunk_bytes=$((chunk_bytes + argument_bytes))
    done
    if [ "${#chunk[@]}" -ne 0 ]; then
        BUILD_POOL="${BUILD_POOL:-4}" run_build "${chunk[@]}" || fail "$message"
    fi
}

# No two tracked paths may differ only in case — such a pair cannot check out on
# Windows/macOS (case-insensitive FS), silently dropping a file and breaking those
# clones. Reflects the staged index, so a colliding add is caught before it lands.
python3 tools/check_case_collisions.py || fail "case-only path collision (see above)"

# Owner decision (2026-08-29): this repo keeps NO lessons.md — in Open-BFME-1 it
# is a plague that keeps growing back. Codegen findings go in the commit message
# of the body that proved them.
if git diff --cached --name-only --diff-filter=ACR | grep -qiE '(^|/)lessons[^/]*\.md$'; then
    fail "lessons.md is banned in this repo — put the finding in the commit message"
fi

# A script under tools/ is neither a Code/ source nor a ledger file, so nothing
# else in this hook looks at it: one with a syntax error commits cleanly and only
# fails when somebody next runs it. That has happened. One parse per staged tool
# costs nothing and closes it.
capture staged_tools_out "listing staged tools" git diff --cached --name-only --diff-filter=ACM -- 'tools/*.py'
mapfile -t staged_tools < "$staged_tools_out"
rm -f "$staged_tools_out"
if [ "${#staged_tools[@]}" -ne 0 ]; then
    printf '%s\0' "${staged_tools[@]}" | python3 -c '
import ast, os, sys
bad = 0
for path in map(os.fsdecode, sys.stdin.buffer.read().split(b"\0")[:-1]):
    try:
        ast.parse(open(path, encoding="utf-8").read(), filename=path)
    except SyntaxError as exc:
        print("  %s:%s: %s" % (path, exc.lineno, exc.msg), file=sys.stderr)
        bad = 1
sys.exit(bad)
' || fail "python syntax error in a staged tool (see above)"
fi

# Direction: conversions run asm -> C++, never the reverse. Byte-verification
# cannot see this (an __emit lift of a retail dump is byte-true), so it gets
# its own gate: no new naked/__emit bodies outside Code/gen_small/, and no
# clean-C++ ledger row repointed back at assembly.
python3 tools/conversion_gate.py HEAD : || fail "conversion direction (see above)"
# A literal image address matches bytes but breaks the linked build; name the global.
python3 tools/link_debt.py --staged || fail "new hard-coded image address (see above)"
# A class with a shared header (reverse/canonical_classes.csv) gets no new private copies.
python3 tools/class_gate.py --staged || fail "new private copy of a class with a shared header (see above)"
# Structure invariants, SHADOW: one owner per retail address, rows only into their
# approved TU (reverse/tu_map.csv), no private copy of a registered class. Reports,
# never refuses, until its measured false-rejection rate is under budget.
python3 tools/tu_ownership.py --staged --shadow || echo "pre-commit: tu_ownership shadow check failed to run (ignored)" >&2
python3 tools/hatch_counters.py --staged || fail "escape hatches grew or a retail inventory was hand-edited (see above)"
python3 tools/code_identity_gate.py --staged || fail "code identity: wrong binding, duplicate definition or hand-made alias (see above)"

staged_sources=()
ledger_changed=0
wide_change=0
flags_changed=0
baseline_changed=0
attempts_changed=0
capture staged_out "listing staged files" git diff --cached --name-only --diff-filter=ACMRT
while IFS= read -r path; do
    case "$path" in
        # .c and .asm rows are byte-verified like .cpp: two of the six
        # wrong switch mappings found in 2026-10 sat in .c files this hook
        # never compiled.
        Code/*.cpp|Code/*.c|Code/*.asm) staged_sources+=("$path") ;;
        reverse/pin_consistency_baseline.csv|reverse/gate_baseline.txt|reverse/eh_baseline.csv) baseline_changed=1 ;;
        # Region flags decide how every Code/ TU compiles (tools/flag_defaults.py).
        reverse/retail_inventory/flag_regions.csv|reverse/flag_overrides.csv) flags_changed=1 ;;
        reverse/functions.csv|reverse/symbols.csv|reverse/deleted_rows.csv|reverse/re_attempts.log) ledger_changed=1 ;;
        # A stash-only commit changes no ledger and no source, so without this
        # it takes the early exit below and check_csv never validates the very
        # file it just added. It stays out of the byte-verify set: a banked
        # body is evidence, not a compiled source.
        reverse/attempts/*) attempts_changed=1 ;;
        # A header or shim recompiles many TUs while changing NO ledger rows,
        # so the delta byte-verify below would prove nothing. Any such change
        # forces the full gate — this is exactly how a layout-shim experiment
        # could otherwise land a silent regression.
        *.h|reference/shims/*) wide_change=1 ;;
    esac
done < "$staged_out"
rm -f "$staged_out"

# Placement: game sources live only under Code/ at the official BFME path
# (plus reference/shims/ for shim headers, reference/CnC_Generals_Zero_Hour/ for
# restoring vendored EA reference source, and tools/tests/ for fixtures).
# No src/, no invented layouts, no sources at the repo root.
#
# mods/ is allowed too, and deliberately is NOT under Code/. It holds mod
# payloads that are patched into a copy of the retail image, never compiled
# into the byte-exact rebuild -- keeping them out of Code/ is what stops a mod
# from ever influencing the byte gate. They would fail this check as .asm
# files, so the list names the tree explicitly rather than being bypassed.
#
# reverse/attempts/ is named for the same reason: a banked near-miss body is
# evidence for the next agent, never a compiled source, so it must sit outside
# Code/ where verify_source_claims would demand matched rows for it.
capture added_out "listing added files" git diff --cached --name-only --diff-filter=A
while IFS= read -r path; do
    case "$path" in
        Code/GameEngine/*|Code/GameEngineDevice/*|Code/Libraries/*|Code/gen_small/*|Code/gen_asm/*|Code/masm_dumps/*|reference/shims/*|reference/CnC_Generals_Zero_Hour/*|tools/tests/*|build/toolchains/*|mods/*|reverse/attempts/*) ;;
        *) fail "source added outside official tree: $path — see AGENTS.md 'File placement'" ;;
    esac
done < <(grep -E '\.(cpp|c|h|hpp|asm)$' "$added_out" || true)
rm -f "$added_out"

# Data identity (shadow): staged sources' DIR32 data references against
# reverse/data_ledger.csv; fails only when reverse/data_check_baseline.txt grew.
# It runs before the early exit below, which a baseline-only commit takes.
python3 tools/data_check.py --staged || fail "data identity: staged data_check_baseline.txt grew (see above)"

if [ "${#staged_sources[@]}" -eq 0 ] && [ "$ledger_changed" -eq 0 ] \
   && [ "$wide_change" -eq 0 ] && [ "$flags_changed" -eq 0 ] && [ "$baseline_changed" -eq 0 ] \
   && [ "$attempts_changed" -eq 0 ]; then
    exit 0
fi

# The build reads the WORKING-TREE ledgers. An unstaged row edit (a rename the
# staged units need) would make them verify green against rows this commit does
# not contain, leaving HEAD inconsistent; refuse before anything is verified.
python3 tools/ledger_guard.py --staged || fail "unstaged ledger edits would be verified instead of the staged ledger (see above)"

if [ "$wide_change" -ne 0 ]; then
    # Byte-verify only the ledger sources the changed headers can reach
    # (tools/header_dependents.py, ported from Open-BFME-1: it walks the
    # #include graph of the index by file NAME, widens on every doubt and exits
    # 2 when it cannot bound the change); otherwise the full gate, as before.
    header_deps_out=$(mktemp)
    if python3 tools/header_dependents.py --staged > "$header_deps_out"; then
        mapfile -t header_deps < "$header_deps_out"
        rm -f "$header_deps_out"
        capture staged_out "listing staged files" git diff --cached --name-only --diff-filter=ACMRT
        while IFS= read -r path; do
            case "$path" in
                *.h|*.hpp|*.hh|*.hxx|*.inl|*.inc|reference/shims/*|Code/*)
                    git diff --quiet -- "$path" || fail "unstaged edits in $path: the scoped header gate would verify the wrong bytes" ;;
            esac
        done < "$staged_out"
        rm -f "$staged_out"
        declare -A unstaged=()
        capture unstaged_out "listing unstaged edits" git diff --name-only -z
        while IFS= read -r -d '' path; do unstaged["$path"]=1; done < "$unstaged_out"
        rm -f "$unstaged_out"
        for path in "${header_deps[@]}"; do
            [ -z "${unstaged[$path]:-}" ] || fail "unstaged edits in $path: the scoped header gate would verify the wrong bytes"
        done
        echo "pre-commit: header/shim change — scoped gate over ${#header_deps[@]} dependent source(s)" >&2
        build_chunks "scoped header gate (see above)" "${header_deps[@]}"
    else
        rm -f "$header_deps_out"
        echo "pre-commit: header/shim change — running FULL gate (header_dependents could not bound it)" >&2
        BUILD_POOL="${BUILD_POOL:-4}" run_build || fail "full gate after header/shim change (see above)"
    fi
fi

# Region or override changes move the flags of TUs no #include graph names.
if [ "$flags_changed" -ne 0 ]; then
    echo "pre-commit: flag region/override change — running FULL gate" >&2
    BUILD_POOL="${BUILD_POOL:-4}" run_build || fail "full gate after flag region/override change (see above)"
fi

# The build verifies file contents on disk; refuse if a file being committed
# also has unstaged edits, or we would be proving the wrong bytes.
# One `git diff` for the whole worktree, not one per source: 1,500 staged sources
# cost ~1,500 Git processes here otherwise, and a path is matched exactly rather
# than as a pathspec.
unstaged_out=$(mktemp)
git diff --name-only -z > "$unstaged_out" || { rm -f "$unstaged_out"; fail "listing unstaged edits"; }
declare -A unstaged_paths=()
while IFS= read -r -d '' path; do unstaged_paths["$path"]=1; done < "$unstaged_out"
rm -f "$unstaged_out"
dirty=()
for path in "${staged_sources[@]}"; do
    if [ -n "${unstaged_paths[$path]:-}" ]; then
        dirty+=("$path")
    fi
done
for ledger in reverse/functions.csv reverse/symbols.csv reverse/deleted_rows.csv \
              reverse/re_attempts.log reverse/pin_consistency_baseline.csv \
              reverse/gate_baseline.txt; do
    if ! git diff --cached --quiet -- "$ledger" && ! git diff --quiet -- "$ledger"; then
        dirty+=("$ledger")
    fi
done
if [ "${#dirty[@]}" -ne 0 ]; then
    printf '  unstaged edits in: %s\n' "${dirty[@]}" >&2
    fail "staged verification files also have unstaged edits; build would not verify the staged content"
fi

# 1) Static ledger integrity (<1s): duplicate rows, conflicting or overlapping
#    claims, malformed rows, missing sources. Turns union-merge corruption into
#    an immediate loud failure instead of someone else's red build later.
python3 tools/check_csv.py --staged || fail "ledger integrity (see above)"
python3 tools/flag_defaults.py check || fail "flag overrides edited by hand (see above)"

# 1b) Identity, not bytes. reverse/symbols.csv is an ADDITIVE candidate list:
#     the REL32 resolver keeps the first pinned address that reproduces retail,
#     so a pin naming the WRONG function still byte-matches and the delta build
#     below proves nothing about it. Only the full gate ran this guard, and a
#     ledger-only edit never triggers the full gate — it takes the scoped path —
#     so the one check built for exactly this change had never run on it. 1.6s,
#     reads only the retail image and the ledgers.
if [ "$ledger_changed" -ne 0 ]; then
    python3 tools/pin_consistency.py --check || fail "pin consistency (see above)"
    # New pins and object-symbol= alias rows are admitted only by rule
    # (RVA in the image, code not data, no second real name on one address,
    # no new alias rows): tools/pin_admission.py.
    python3 tools/pin_admission.py --staged || fail "pin/alias admission (see above)"
fi
# The baseline is a debt register that may only shrink. --write-baseline refuses
# to grow it, but a hand-typed line is the same anti-pattern, so the committed
# file is checked against HEAD as well.
if [ "$baseline_changed" -ne 0 ]; then
    python3 tools/pin_consistency.py --assert-shrink-only HEAD \
        || fail "pin_consistency_baseline.csv grew (see above)"
    python3 tools/eh_verify.py --assert-shrink-only HEAD || fail "eh_baseline.csv grew (see above)"
    if git cat-file -e HEAD:tools/gate_baseline.py 2>/dev/null; then
        git show HEAD:tools/gate_baseline.py | python3 - --assert-shrink-only HEAD \
            || fail "gate_baseline.txt grew (see above)"
    fi
    # A deleted debt line is credited as a repair (next_work, progress_v2,
    # agent_yield), so its row is re-verified: the delta verify builds staged
    # sources, this builds the rest. HEAD's checker, so an edit cannot approve itself.
    if git cat-file -e HEAD:tools/repair_queue.py 2>/dev/null; then
        git show HEAD:tools/repair_queue.py | python3 - verify-removed \
            || fail "a deleted gate-debt line's row still fails its check (see above)"
    fi
fi

# 2) Every function defined in staged sources must be declared in the ledger.
if [ "${#staged_sources[@]}" -ne 0 ]; then
    printf '%s\0' "${staged_sources[@]}" \
        | python3 tools/find_declared_unmatched.py --fail --staged --paths-from - \
        || fail "staged sources define functions the ledger does not declare (see above)"
fi

# 3) Byte-verify the delta: staged sources plus sources of any ledger rows this
#    commit adds or edits. Seconds per file. Row deletions and dedup reorders
#    verify nothing extra — they cannot break byte-truth.
declare -A verify_set=()
for path in "${staged_sources[@]}"; do verify_set["$path"]=1; done
capture delta_out "delta_sources" python3 tools/delta_sources.py --staged
while IFS= read -r path; do
    [ -n "$path" ] && verify_set["$path"]=1
done < "$delta_out"
rm -f "$delta_out"
# 3a) ...and every OTHER unit whose object calls a name this commit renames,
#     removes or re-addresses (a row or a symbols.csv pin): its call sites
#     resolve through that name, so it stops matching although neither it nor
#     its rows changed. One retracted row name broke 38 rows in 40 such units,
#     every hook green (fork a7a39472e7). Free unless a call target is lost;
#     then one scan of the object cache (tools/name_dependents.py).
capture name_deps_out "listing the units that call a renamed or removed name" \
    python3 tools/name_dependents.py --staged
while IFS= read -r path; do
    [ -n "$path" ] || continue
    # The build reads the working copy, not what this commit contains.
    [ -z "${unstaged_paths[$path]:-}" ] || { rm -f "$name_deps_out"
        fail "unstaged edits in $path, which calls a name this commit renames or removes: stage or stash them"; }
    verify_set["$path"]=1
done < "$name_deps_out"
rm -f "$name_deps_out"

# Parked reconstruction drafts (whitelisted zero-matched-row sources) have
# nothing to byte-verify; build.py errors on a filter that matches no rows.
# NUL-separated both ways: print() ends a line in CR LF on Windows, so the CR-
# suffixed key `read` produced never matched and this filter removed nothing.
if [ "${#verify_set[@]}" -ne 0 ]; then
    unclaimed_out=$(mktemp)
    printf '%s\0' "${!verify_set[@]}" | python3 -c '
import csv, os, sys
claimed = {r["source"] for r in csv.DictReader(open("reverse/functions.csv"))
           if r.get("status") == "matched"}
for p in sys.stdin.buffer.read().split(b"\0")[:-1]:
    if os.fsdecode(p) not in claimed:
        sys.stdout.buffer.write(p + b"\0")
' > "$unclaimed_out" || { rm -f "$unclaimed_out"; fail "filtering claimed sources (see above)"; }
    while IFS= read -r -d '' path; do
        unset "verify_set[$path]"
    done < "$unclaimed_out"
    rm -f "$unclaimed_out"
fi

if [ "${#verify_set[@]}" -ne 0 ]; then
    build_chunks "byte-verify of changed sources (see above)" "${!verify_set[@]}"
    printf '%s\0' "${!verify_set[@]}" | python3 tools/eh_verify.py --sources-from - \
        || fail "exception data differs from retail (see above)"
fi

# 4) Link admission, SHADOW: a new unit's COMDAT copy that would break the link
#    for others -- a wrong copy of a ledger-owned name, or a second body for one
#    every linked object shares, where link.exe would keep it over the copy they
#    link against: first in link order (lowest matched RVA, as the census
#    orders objects). Three donor ports re-blocked 56 units this way. A copy the
#    link discards charges only its own unit and is not reported. Judged
#    against the link census index by tools/link_check.py --new-variants; the
#    commit's other staged units are judged by their current objects, so a body
#    moved between them is one copy. Skipped without a census index
#    (build/link_census/link_index.pkl). After step 3, whose build made the new
#    units' objects current. Reports, never refuses, until its false-refusal
#    rate is measured on live traffic (docs/verifier_upgrade_plan.md, step 3:
#    48 h, no correct work rejected); promotion drops --shadow.
capture new_units_out "listing added units" \
    git diff --cached --name-only -z --diff-filter=A -- 'Code/*.cpp' 'Code/*.c'
new_units=()
while IFS= read -r -d '' path; do
    case "$path" in
        Code/gen_asm/*|Code/gen_small/*) ;;
        *) new_units+=("$path") ;;
    esac
done < "$new_units_out"
rm -f "$new_units_out"
if [ "${#new_units[@]}" -ne 0 ]; then
    printf '%s\0' "${new_units[@]}" \
        | python3 tools/link_check.py --new-variants --staged-peers --shadow --paths-from - \
        || echo "pre-commit: link admission shadow check failed to run (ignored)" >&2
fi

echo "PRE-COMMIT OK (ledger integrity + ${#verify_set[@]} source(s) byte-verified)"
