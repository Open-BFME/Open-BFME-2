# Byte-exact payloads the build verifies by hash; EOL normalization would
# silently break byte-matching. (The MSVC toolchain lives in the Open-BFME-1
# submodule, which carries its own attributes.)
baselines/** -text
# The vendored DirectX SDK: tools/build.py hashes these files against its
# PROVENANCE.txt before a `// dxsdk` unit compiles. The headers are CRLF.
vendor/dxsdk-aug2005/** -text

# Banked attempts are evidence that check_csv measures byte for byte (one
# function body, at most 65,536 bytes). A Windows checkout with autocrlf turned
# a 64,870-byte stash into 66,866 bytes and failed CI's ledger check; checking
# them out exactly as stored keeps the measure the same on every host.
reverse/attempts/*.cpp -text

# Git for Windows executes these through bash; CRLF corrupts the shebang and
# can make the verification policy disappear before it runs.
.githooks/* text eol=lf

# ledger_guard compares these compiler decisions to their Git blobs byte for
# byte. A clean core.autocrlf=true checkout must not rewrite them to CRLF.
tools/build.py text eol=lf
tools/compiler_profiles.py text eol=lf
vendor/clang23-x86/compiler.zip -text
tools/flag_defaults.py text eol=lf
build.sh text eol=lf
build.cmd text eol=lf
reverse/retail_inventory/flag_regions.csv text eol=lf
reverse/flag_overrides.csv text eol=lf

# Append-mostly ledgers written concurrently by many agents. Union merge
# combines both sides' added lines instead of emitting conflict markers, so
# parallel row appends never conflict. git's built-in union also brings back
# rows one side deleted or edited, so clones register tools/merge_rows.py under
# the name `union` (tools/setup_hooks.sh, .githooks/pre-commit) to remove them;
# a clone without it still gets plain union, never a conflict. A row both sides
# edited differently keeps both versions; each ledger's own checks decide
# whether they can stand together (check_csv refuses two functions.csv rows for
# one name and address, and accepts two symbols.csv addresses for one name).
# No baseline, whitelist or other shrink-only list belongs here. This repo's
# ledgers are LF-terminated from birth — keep them that way (BFME 1's mixed
# terminators were pure legacy pain; `check_csv` rejects a mixed file).
reverse/functions.csv text eol=lf merge=union
reverse/symbols.csv text eol=lf merge=union
reverse/deleted_rows.csv text eol=lf merge=union
reverse/re_attempts.log text eol=lf merge=union
reverse/body_owners.csv text eol=lf merge=union
# data_rows.csv (tools/data_rows.py): one owner per address, appended like the others
reverse/data_rows.csv text eol=lf merge=union
# Naming provenance and hashed spelling/meaning votes: append-only
# provenance every seat and the daily pass write at end of file
reverse/name_basis.csv text eol=lf merge=union
reverse/name_agreed.csv text eol=lf merge=union
reverse/name_votes.csv text eol=lf merge=union
reverse/name_meanings.csv text eol=lf merge=union
# Ledgers tu_skeleton --merge and rename.py repoint through ledger_io.lf_terminator,
# which refuses CRLF: a core.autocrlf=true checkout (T3 and other worktrees not made by
# tools/worktree_setup.py) aborted merges halfway, after functions.csv was already
# edited (2026-10-28). Not union-merged: each has one writer per change.
reverse/tu_map.csv text eol=lf
reverse/tu_map.inputs.sha256 text eol=lf
reverse/hatch_baseline.tsv text eol=lf
reverse/data_check_baseline.txt text eol=lf
reverse/code_identity_baseline.tsv text eol=lf
reverse/data_ledger.csv text eol=lf
reverse/header_queue.tsv text eol=lf
reverse/ms_header_queue.tsv text eol=lf
reverse/data_converged.csv text eol=lf
# image_ownership_history.csv (tools/image_ownership.py): append-only signed rows, checked
# against the committed bytes; LF from birth like the other ledgers, never union-merged.
reverse/image_ownership_history.csv text eol=lf

# Preserve the pristine STLport archive bytes, including mixed release EOLs.
vendor/stlport-4.6/** -text
vendor/stlport-4.6-bfme/** -text
